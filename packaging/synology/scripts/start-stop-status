#!/bin/sh

BIN="${SYNOPKG_PKGDEST}/bin/nas-gallery"
CFG="${SYNOPKG_PKGVAR}/config.yaml"
PID_FILE="${SYNOPKG_PKGVAR}/nas-gallery.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/nas-gallery.log"

is_running() {
  [ -f "${PID_FILE}" ] || return 1
  pid=$(cat "${PID_FILE}" 2>/dev/null)
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

case "$1" in
  start)
    if is_running; then
      exit 0
    fi
    mkdir -p "${SYNOPKG_PKGVAR}"
    nohup "${BIN}" serve -c "${CFG}" >> "${LOG_FILE}" 2>&1 </dev/null &
    pid=$!
    echo "${pid}" > "${PID_FILE}"
    sleep 1
    if kill -0 "${pid}" 2>/dev/null; then
      exit 0
    fi
    rm -f "${PID_FILE}"
    exit 1
    ;;
  stop)
    if ! is_running; then
      rm -f "${PID_FILE}"
      exit 0
    fi
    pid=$(cat "${PID_FILE}" 2>/dev/null)
    kill -TERM "${pid}" 2>/dev/null || true
    i=0
    while [ "${i}" -lt 10 ]; do
      if ! kill -0 "${pid}" 2>/dev/null; then
        rm -f "${PID_FILE}"
        exit 0
      fi
      sleep 1
      i=$((i + 1))
    done
    kill -KILL "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  log)
    echo "${LOG_FILE}"
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
